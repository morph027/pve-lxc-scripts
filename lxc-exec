#!/bin/bash

if [[ "${1}" =~ ^[0-9]*$ ]]; then
	if [ -d "/sys/fs/cgroup/lxc/${1}" ]; then
		container="${1}"
		shift
		cmd="$*"
		echo -ne "\e[1;32mexecuting \"${cmd}\" in container #${container} ($(grep -m 1 hostname "/etc/pve/lxc/${container}.conf" | awk '{print $NF}'))\e[0m\n"
		pct exec "${container}" /bin/sh -- -c "${cmd}"
	else
		echo -ne "\e[1;31mcontainer $1 is not running\e[0m\n"
		exit 1
	fi
fi
